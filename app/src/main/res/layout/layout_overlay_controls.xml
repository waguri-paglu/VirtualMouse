<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_floating_pill"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- Drag Handle -->
    <View
        android:id="@+id/drag_handle"
        android:layout_width="16dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="#475569" />

    <!-- Left Click Button -->
    <Button
        android:id="@+id/btn_left_click"
        android:layout_width="64dp"
        android:layout_height="48dp"
        android:text="L"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3B82F6"
        android:layout_marginEnd="6dp" />

    <!-- Mode Toggle Button (Trackpad <-> Normal Touch Passthrough) -->
    <LinearLayout
        android:id="@+id/btn_toggle_mode"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/bg_floating_button"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODE"
            android:textSize="9sp"
            android:textColor="#94A3B8" />

        <TextView
            android:id="@+id/tv_mode_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRACKPAD"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#10B981" />
    </LinearLayout>

    <!-- Right Click Button -->
    <Button
        android:id="@+id/btn_right_click"
        android:layout_width="64dp"
        android:layout_height="48dp"
        android:text="R"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6366F1"
        android:layout_marginStart="6dp" />

</LinearLayout>
